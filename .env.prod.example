# ============================================================================
# 生产环境 .env 模板 —— 复制到服务器 /opt/fawn-mall/.env 并填真实值(chmod 600)
# 与 CI/CD 的对应关系:REGISTRY/NAMESPACE 必须与 GitHub Variables
# TCR_REGISTRY/TCR_NAMESPACE 完全一致,否则服务器拉不到镜像。
# ============================================================================

# ── 镜像仓库(与 .github/workflows/cd.yml 顶部 env 固定值一致)──
REGISTRY=ccr.ccs.tencentyun.com
NAMESPACE=fawn_mall
# 自动跟随主干;固定版本用 v1.2.3 / sha-xxxxxxx(回滚改这里)
TAG=main

# ── 数据库:腾讯云 MySQL(内网直连,不经宿主端口)────────────────
DB_HOST=172.16.0.3
DB_PORT=3306
DB_NAME=fawn_mall
DB_USER=root
DB_PASSWORD=改成强密码或专用账号密码

# ── 中间件口令(本机容器)──────────────────────────────────────
# openssl rand -hex 24 生成
RABBITMQ_USER=fawn
RABBITMQ_PASSWORD=openssl-rand-hex-24-结果

# ── 登录态签名密钥(>=32 字节,启动硬校验)──────────────────────
# openssl rand -hex 32 生成
JWT_SECRET=openssl-rand-hex-32-结果

# ── 七牛对象存储(可选:商品图上传;整体留空=功能关闭,不影响其余)──
# AK/SK 见七牛控制台「个人中心 → 密钥管理」; REGION 为存储区域代码:
#   z0 华东 | z1 华北 | z2 华南 | cn-east-2 华东-浙江2 | na0 北美 | as0 东南亚
# DOMAIN 为空间绑定的外链域名(带 https:// 前缀)
# QINIU_AK=
# QINIU_SK=
# QINIU_BUCKET=
# QINIU_DOMAIN=
# QINIU_REGION=z0

# ── 端口覆盖(仅与其他项目相撞时改,默认即可)──────────────────
# SERVER_PORT=18080
# WEB_PORT=18090
# REDIS_PORT=16379
# MQ_MGMT_PORT=25672
