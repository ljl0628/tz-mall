# 复制为 .env 后按需修改,docker-compose 会自动读取;生产环境务必修改所有默认口令。
# 这些值经 compose 映射为后端 APP_* 环境变量(APP_DB_PASSWORD / APP_JWT_SECRET 等)。
MYSQL_ROOT_PASSWORD=fawn_root_dev
MYSQL_DATABASE=fawn_mall
MYSQL_USER=fawn
MYSQL_PASSWORD=fawn_dev_123
RABBITMQ_USER=fawn
RABBITMQ_PASSWORD=fawn_dev_123
# JWT 签名密钥:APP_ENV=prod 时强制 >= 32 字节
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef0123456789
